# Supabase (Project Settings → API). Solo claves PÚBLICAS: nunca pongas aquí la service_role key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# NOTA DE PRODUCCIÓN PARA BOLD PAYMENTS:
# Las siguientes variables deben configurarse como SECRETOS en Supabase Edge Functions:
# En consola: supabase secrets set BOLD_IDENTITY_KEY=... BOLD_SECRET_KEY=... BOLD_WEBHOOK_SECRET=... BOLD_CHECKOUT_URL=https://checkout.bold.co
# O desde el Dashboard de Supabase -> Project Settings -> Edge Functions -> Secrets.
