# Supabase (Project Settings → API). Solo claves PÚBLICAS: nunca pongas aquí la service_role key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Configuración pública de Addi (Config Endpoint en Checkout):
VITE_ADDI_ALLY_SLUG=dcsneakers-ecommerce
VITE_ADDI_ENV=staging

# NOTA DE PRODUCCIÓN PARA BOLD PAYMENTS:
# Las siguientes variables deben configurarse como SECRETOS en Supabase Edge Functions:
# En consola: supabase secrets set BOLD_IDENTITY_KEY=... BOLD_SECRET_KEY=... BOLD_WEBHOOK_SECRET=... BOLD_CHECKOUT_URL=https://checkout.bold.co

# NOTA DE PRODUCCIÓN / STAGING PARA ADDI (BNPL):
# Configurar en Supabase Edge Functions -> Secrets:
# supabase secrets set ADDI_ENV=staging ADDI_CLIENT_ID=... ADDI_CLIENT_SECRET=... ADDI_WEBHOOK_USER=... ADDI_WEBHOOK_PASSWORD=...
